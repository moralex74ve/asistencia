---
import Layout from "../layouts/Layout.astro";
import { prisma } from "../db";

export const prerender = false;

let mensaje = "";
let tipoMensaje = "";

// Manejar POST - Actualizar nivel
if (Astro.request.method === "POST") {
  try {
    const formData = await Astro.request.formData();
    const nivelCod = formData.get("nivel_cod")?.toString();
    const tutorNivel = formData.get("tutor_nivel")?.toString() || null;
    const tim1Nivel = formData.get("tim1_nivel")?.toString() || null;
    const tim2Nivel = formData.get("tim2_nivel")?.toString() || null;

    if (nivelCod) {
      await prisma.discipulado.update({
        where: { nivel_cod: nivelCod },
        data: {
          tutor_nivel: tutorNivel,
          tim1_nivel: tim1Nivel,
          tim2_nivel: tim2Nivel,
        },
      });
      mensaje = "Nivel actualizado correctamente.";
      tipoMensaje = "success";
    }
  } catch (error) {
    console.error("Error al actualizar nivel:", error);
    mensaje = "Error al guardar los datos.";
    tipoMensaje = "error";
  }
}

// Obtener niveles con sus miembros asignados y conteo de integrantes
const niveles = await prisma.discipulado.findMany({
  orderBy: { nivel_cod: "asc" },
  include: {
    tutor_miembro: { select: { id: true, nombre: true, apellido: true } },
    tim1_miembro: { select: { id: true, nombre: true, apellido: true } },
    tim2_miembro: { select: { id: true, nombre: true, apellido: true } },
    _count: { select: { integrantes: true } },
  },
});

// Obtener solo miembros activos para los selects
const miembros = await prisma.miembros.findMany({
  where: { status: true },
  orderBy: { nombre: "asc" },
  select: { id: true, nombre: true, apellido: true },
});

// Serializar datos para JavaScript
const miembrosJSON = JSON.stringify(miembros);
const nivelesJSON = JSON.stringify(
  niveles.map((n) => ({
    nivel_cod: n.nivel_cod,
    tutor_nivel: n.tutor_nivel,
    tim1_nivel: n.tim1_nivel,
    tim2_nivel: n.tim2_nivel,
  }))
);
---

<Layout title="Discipulado">
  <div class="container text-slate-50 mx-auto px-4 py-8 relative">
    <a
      href="/dashboard"
      class="absolute top-5 left-5 text-blue-400 hover:text-blue-300 transition-colors block"
      title="Volver al Menú"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-8 w-8"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M11 15l-3-3m0 0l3-3m-3 3h8M3 12a9 9 0 1118 0 9 9 0 01-18 0z"
        ></path>
      </svg>
    </a>

    <h1 class="text-2xl font-bold mb-6 text-center pt-8">
      Administración de Discipulado
    </h1>

    {
      mensaje && (
        <div
          class:list={[
            "mb-4 px-4 py-3 rounded text-center text-sm font-medium",
            tipoMensaje === "success"
              ? "bg-green-900 text-green-300 border border-green-700"
              : "bg-red-900 text-red-300 border border-red-700",
          ]}
        >
          {mensaje}
        </div>
      )
    }

    <div class="bg-slate-700 text-slate-50 p-6 rounded-lg shadow-md">
      <p class="text-sm text-gray-400 mb-4">
        Seleccione el Tutor, TIM 1 y TIM 2 para cada nivel de discipulado. Use
        el campo de búsqueda para filtrar miembros.
      </p>

      <div class="overflow-x-auto">
        <table
          class="min-w-full divide-y divide-gray-600"
          id="discipulado-table"
        >
          <thead class="bg-slate-800">
            <tr>
              <th
                class="px-4 py-3 text-left text-sm font-semibold text-slate-50"
                >Nivel</th
              >
              <th
                class="px-4 py-3 text-left text-sm font-semibold text-slate-50"
                >Tutor</th
              >
              <th
                class="px-4 py-3 text-left text-sm font-semibold text-slate-50"
                >TIM 1</th
              >
              <th
                class="px-4 py-3 text-left text-sm font-semibold text-slate-50"
                >TIM 2</th
              >
              <th class="px-4 py-3 text-center text-sm font-semibold text-slate-50"
                >Acciones</th
              >
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-600">
            {
              niveles.map((nivel) => (
                <tr data-nivel-cod={nivel.nivel_cod} class="hover:bg-slate-600/50">
                  <td class="px-4 py-3 font-medium whitespace-nowrap">
                    {nivel.nombre_nivel}
                  </td>
                  <td class="px-4 py-3">
                    <div
                      class="searchable-select relative"
                      data-nivel={nivel.nivel_cod}
                      data-role="tutor_nivel"
                    >
                      <input
                        type="text"
                        class="search-input w-full bg-slate-800 border border-gray-500 rounded px-3 py-1.5 text-sm text-slate-50 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500"
                        placeholder="Buscar miembro..."
                        value={nivel.tutor_miembro ? `${nivel.tutor_miembro.nombre} ${nivel.tutor_miembro.apellido}` : ""}
                        autocomplete="off"
                      />
                      <input
                        type="hidden"
                        name="tutor_nivel"
                        value={nivel.tutor_nivel || ""}
                      />
                      <button
                        type="button"
                        class="clear-btn absolute right-2 top-1/2 -translate-y-1/2 text-gray-400 hover:text-red-400 text-sm font-bold hidden"
                        title="Limpiar"
                      >
                        ✕
                      </button>
                      <div class="dropdown-list absolute z-20 w-full mt-1 bg-slate-800 border border-gray-500 rounded shadow-lg max-h-48 overflow-y-auto hidden" />
                    </div>
                  </td>
                  <td class="px-4 py-3">
                    <div
                      class="searchable-select relative"
                      data-nivel={nivel.nivel_cod}
                      data-role="tim1_nivel"
                    >
                      <input
                        type="text"
                        class="search-input w-full bg-slate-800 border border-gray-500 rounded px-3 py-1.5 text-sm text-slate-50 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500"
                        placeholder="Buscar miembro..."
                        value={nivel.tim1_miembro ? `${nivel.tim1_miembro.nombre} ${nivel.tim1_miembro.apellido}` : ""}
                        autocomplete="off"
                      />
                      <input
                        type="hidden"
                        name="tim1_nivel"
                        value={nivel.tim1_nivel || ""}
                      />
                      <button
                        type="button"
                        class="clear-btn absolute right-2 top-1/2 -translate-y-1/2 text-gray-400 hover:text-red-400 text-sm font-bold hidden"
                        title="Limpiar"
                      >
                        ✕
                      </button>
                      <div class="dropdown-list absolute z-20 w-full mt-1 bg-slate-800 border border-gray-500 rounded shadow-lg max-h-48 overflow-y-auto hidden" />
                    </div>
                  </td>
                  <td class="px-4 py-3">
                    <div
                      class="searchable-select relative"
                      data-nivel={nivel.nivel_cod}
                      data-role="tim2_nivel"
                    >
                      <input
                        type="text"
                        class="search-input w-full bg-slate-800 border border-gray-500 rounded px-3 py-1.5 text-sm text-slate-50 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500"
                        placeholder="Buscar miembro..."
                        value={nivel.tim2_miembro ? `${nivel.tim2_miembro.nombre} ${nivel.tim2_miembro.apellido}` : ""}
                        autocomplete="off"
                      />
                      <input
                        type="hidden"
                        name="tim2_nivel"
                        value={nivel.tim2_nivel || ""}
                      />
                      <button
                        type="button"
                        class="clear-btn absolute right-2 top-1/2 -translate-y-1/2 text-gray-400 hover:text-red-400 text-sm font-bold hidden"
                        title="Limpiar"
                      >
                        ✕
                      </button>
                      <div class="dropdown-list absolute z-20 w-full mt-1 bg-slate-800 border border-gray-500 rounded shadow-lg max-h-48 overflow-y-auto hidden" />
                    </div>
                  </td>
                  <td class="px-4 py-3 text-center">
                    <div class="flex items-center justify-center gap-2">
                      <a
                        href={`/discipulado/integrantes/${nivel.nivel_cod}`}
                        class="bg-purple-600 hover:bg-purple-700 text-white text-sm font-medium px-3 py-1.5 rounded transition-colors"
                        title="Gestionar integrantes"
                      >
                        Integrantes ({nivel._count.integrantes})
                      </a>
                      <button
                        type="button"
                        class="save-btn bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium px-4 py-1.5 rounded transition-colors"
                        data-nivel={nivel.nivel_cod}
                        title="Guardar cambios"
                      >
                        Guardar
                      </button>
                    </div>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </div>
</Layout>

<script
  define:vars={{ miembrosJSON, nivelesJSON }}
>
  function initDiscipulado() {
    const miembros = JSON.parse(miembrosJSON);
    const niveles = JSON.parse(nivelesJSON);

    // Mapa de asignaciones: { nivel_cod: { tutor_nivel: id, tim1_nivel: id, tim2_nivel: id } }
    const asignaciones = {};
    for (const n of niveles) {
      asignaciones[n.nivel_cod] = {
        tutor_nivel: n.tutor_nivel || "",
        tim1_nivel: n.tim1_nivel || "",
        tim2_nivel: n.tim2_nivel || "",
      };
    }

    function getRolesAsignados(excluirNivel, excluirRole) {
      const asignados = new Set();
      for (const [cod, roles] of Object.entries(asignaciones)) {
        if (cod === excluirNivel) continue;
        for (const [role, id] of Object.entries(roles)) {
          if (role === excluirRole && id) continue;
          if (id) asignados.add(id);
        }
      }
      return asignados;
    }

    function getMiembrosAsignadosEnOtroNivel(excluirNivel) {
      const asignados = new Set();
      for (const [cod, roles] of Object.entries(asignaciones)) {
        if (cod === excluirNivel) continue;
        for (const id of Object.values(roles)) {
          if (id) asignados.add(id);
        }
      }
      return asignados;
    }

    function renderDropdown(container, search = "") {
      const dropdown = container.querySelector(".dropdown-list");
      const hiddenInput = container.querySelector('input[type="hidden"]');
      const nivelCod = container.dataset.nivel;
      const role = container.dataset.role;
      const currentValue = hiddenInput.value;
      const searchLower = search.toLowerCase();
      const asignadosEnOtroNivel = getMiembrosAsignadosEnOtroNivel(nivelCod);

      let html = "";

      // Opción "Sin asignar"
      html += `<div class="option-item px-3 py-2 text-sm cursor-pointer hover:bg-blue-600 text-gray-300 border-b border-gray-600 ${!currentValue ? "bg-blue-900/40" : ""} sin-asignar" data-value="">— Sin asignar —</div>`;

      // Filtrar miembros
      const filtrados = miembros.filter((m) => {
        const nombre = `${m.nombre} ${m.apellido}`.toLowerCase();
        return nombre.includes(searchLower);
      });

      if (filtrados.length === 0) {
        html += `<div class="px-3 py-2 text-sm text-gray-500">No se encontraron miembros</div>`;
      } else {
        for (const m of filtrados) {
          const nombre = `${m.nombre} ${m.apellido}`;
          const isSelected = m.id === currentValue;
          const isDisabled = asignadosEnOtroNivel.has(m.id) && !isSelected;
          html += `<div class="option-item px-3 py-2 text-sm cursor-pointer hover:bg-blue-600 ${isSelected ? "bg-blue-600 text-white" : isDisabled ? "opacity-40 cursor-not-allowed text-gray-400" : "text-slate-50"} ${isDisabled ? "disabled" : ""}" data-id="${m.id}" data-nombre="${nombre}" ${isDisabled ? 'data-disabled="true"' : ""}>${nombre}</div>`;
        }
      }

      dropdown.innerHTML = html;
    }

    function updateClearBtn(container) {
      const hiddenInput = container.querySelector('input[type="hidden"]');
      const clearBtn = container.querySelector(".clear-btn");
      if (hiddenInput.value) {
        clearBtn.classList.remove("hidden");
        clearBtn.classList.add("block");
      } else {
        clearBtn.classList.add("hidden");
        clearBtn.classList.remove("block");
      }
    }

    // Inicializar cada searchable-select
    document.querySelectorAll(".searchable-select").forEach((container) => {
      const searchInput = container.querySelector(".search-input");
      const hiddenInput = container.querySelector('input[type="hidden"]');
      const dropdown = container.querySelector(".dropdown-list");
      const clearBtn = container.querySelector(".clear-btn");
      const nivelCod = container.dataset.nivel;
      const role = container.dataset.role;

      // Evento: focus en input → mostrar dropdown
      searchInput.addEventListener("focus", () => {
        renderDropdown(container, searchInput.value);
        dropdown.classList.remove("hidden");
      });

      // Evento: escribir → filtrar
      searchInput.addEventListener("input", () => {
        renderDropdown(container, searchInput.value);
        dropdown.classList.remove("hidden");
        // Si se borra el texto, limpiar selección
        if (!searchInput.value) {
          hiddenInput.value = "";
          asignaciones[nivelCod][role] = "";
          updateClearBtn(container);
        }
      });

      // Evento: clic en opción
      dropdown.addEventListener("click", (e) => {
        const option = e.target.closest(".option-item");
        if (!option) return;

        // No seleccionar miembros deshabilitados
        if (option.dataset.disabled === "true") return;

        const id = option.dataset.id || "";
        const nombre = option.dataset.nombre || "";

        hiddenInput.value = id;
        searchInput.value = id ? nombre : "";
        asignaciones[nivelCod][role] = id;
        dropdown.classList.add("hidden");
        updateClearBtn(container);
      });

      // Evento: clic fuera → cerrar dropdown
      document.addEventListener("click", (e) => {
        if (!container.contains(e.target)) {
          dropdown.classList.add("hidden");
        }
      });

      // Evento: limpiar
      clearBtn.addEventListener("click", () => {
        hiddenInput.value = "";
        searchInput.value = "";
        asignaciones[nivelCod][role] = "";
        updateClearBtn(container);
        searchInput.focus();
      });

      // Estado inicial del botón limpiar
      updateClearBtn(container);
    });

    // Evento: guardar
    document.querySelectorAll(".save-btn").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const nivelCod = btn.dataset.nivel;
        const asignacion = asignaciones[nivelCod];

        const formData = new FormData();
        formData.append("intent", "actualizar");
        formData.append("nivel_cod", nivelCod);
        formData.append("tutor_nivel", asignacion.tutor_nivel || "");
        formData.append("tim1_nivel", asignacion.tim1_nivel || "");
        formData.append("tim2_nivel", asignacion.tim2_nivel || "");

        btn.disabled = true;
        btn.textContent = "Guardando...";

        try {
          const response = await fetch("/discipulado", {
            method: "POST",
            body: formData,
          });

          if (response.ok) {
            btn.textContent = "✓ Guardado";
            btn.classList.remove("bg-blue-600", "hover:bg-blue-700");
            btn.classList.add("bg-green-600");
            setTimeout(() => {
              btn.textContent = "Guardar";
              btn.classList.remove("bg-green-600");
              btn.classList.add("bg-blue-600", "hover:bg-blue-700");
              btn.disabled = false;
            }, 2000);
          } else {
            throw new Error("Error en la respuesta");
          }
        } catch (error) {
          console.error("Error:", error);
          btn.textContent = "Error";
          btn.classList.remove("bg-blue-600", "hover:bg-blue-700");
          btn.classList.add("bg-red-600");
          setTimeout(() => {
            btn.textContent = "Guardar";
            btn.classList.remove("bg-red-600");
            btn.classList.add("bg-blue-600", "hover:bg-blue-700");
            btn.disabled = false;
          }, 2000);
        }
      });
    });
  }

  document.addEventListener("astro:page-load", initDiscipulado);
</script>
