---
import Layout from "../../../layouts/Layout.astro";
import { prisma } from "../../../db";

export const prerender = false;

const { nivel_cod } = Astro.params;

if (!nivel_cod) {
  return Astro.redirect("/discipulado");
}

let mensaje = "";
let tipoMensaje = "";

// Manejar POST - Agregar o eliminar integrante
if (Astro.request.method === "POST") {
  try {
    const formData = await Astro.request.formData();
    const intent = formData.get("intent")?.toString();

    if (intent === "agregar") {
      const miembroId = formData.get("miembro_id")?.toString();
      if (miembroId && nivel_cod) {
        await prisma.integrantes_discipulado.create({
          data: {
            miembro_id: miembroId,
            nivel_cod: nivel_cod,
          },
        });
        // Actualizar campo discipulado a "s" si es "n" o "p"
        await prisma.miembros.updateMany({
          where: {
            id: miembroId,
            discipulado: { in: ["n", "p"] },
          },
          data: { discipulado: "s" },
        });
        mensaje = "Integrante agregado correctamente.";
        tipoMensaje = "success";
      }
    } else if (intent === "eliminar") {
      const integranteId = formData.get("integrante_id")?.toString();
      if (integranteId) {
        await prisma.integrantes_discipulado.delete({
          where: { id: integranteId },
        });
        mensaje = "Integrante eliminado correctamente.";
        tipoMensaje = "success";
      }
    }
  } catch (error) {
    console.error("Error:", error);
    mensaje = "Error al procesar la solicitud.";
    tipoMensaje = "error";
  }
}

// Obtener info del nivel
const nivel = await prisma.discipulado.findUnique({
  where: { nivel_cod },
  select: { nivel_cod: true, nombre_nivel: true },
});

if (!nivel) {
  return Astro.redirect("/discipulado");
}

// Obtener integrantes actuales del nivel
const integrantesActuales = await prisma.integrantes_discipulado.findMany({
  where: { nivel_cod },
  include: {
    miembro: {
      select: { id: true, nombre: true, apellido: true, cedula: true },
    },
  },
  orderBy: { miembro: { nombre: "asc" } },
});

// IDs de miembros ya asignados a este nivel
const idsAsignados = integrantesActuales.map((i) => i.miembro_id);

// Obtener miembros activos que NO estén ya en este nivel
const miembrosDisponibles = await prisma.miembros.findMany({
  where: {
    status: true,
    id: { notIn: idsAsignados },
  },
  orderBy: { nombre: "asc" },
  select: { id: true, nombre: true, apellido: true },
});

const integrantesJSON = JSON.stringify(
  integrantesActuales.map((i) => ({
    id: i.id,
    miembro_id: i.miembro_id,
    nombre: i.miembro.nombre,
    apellido: i.miembro.apellido,
    cedula: i.miembro.cedula,
  }))
);

const miembrosJSON = JSON.stringify(miembrosDisponibles);
---

<Layout title={`Integrantes - ${nivel.nombre_nivel}`}>
  <div class="container text-slate-50 mx-auto px-4 py-8 relative">
    <a
      href="/discipulado"
      class="absolute top-5 left-5 text-blue-400 hover:text-blue-300 transition-colors block"
      title="Volver a Discipulado"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-8 w-8"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M11 15l-3-3m0 0l3-3m-3 3h8M3 12a9 9 0 1118 0 9 9 0 01-18 0z"
        ></path>
      </svg>
    </a>

    <h1 class="text-2xl font-bold mb-2 text-center pt-8">
      Integrantes - {nivel.nombre_nivel}
    </h1>
    <p class="text-center text-gray-400 mb-6 text-sm">
      {integrantesActuales.length} integrante(s) registrado(s)
    </p>

    {
      mensaje && (
        <div
          class:list={[
            "mb-4 px-4 py-3 rounded text-center text-sm font-medium max-w-xl mx-auto",
            tipoMensaje === "success"
              ? "bg-green-900 text-green-300 border border-green-700"
              : "bg-red-900 text-red-300 border border-red-700",
          ]}
        >
          {mensaje}
        </div>
      )
    }

    <!-- Sección para agregar integrante -->
    <div class="bg-slate-700 text-slate-50 p-6 rounded-lg shadow-md mb-6 max-w-xl mx-auto">
      <h2 class="text-lg font-semibold mb-4">Agregar Integrante</h2>
      <form method="POST" class="flex items-end gap-3">
        <input type="hidden" name="intent" value="agregar" />
        <div class="flex-1">
          <label for="miembro-select" class="block text-sm text-gray-400 mb-1"
            >Seleccionar miembro</label
          >
          <div class="searchable-select relative" id="miembro-select">
            <input
              type="text"
              class="search-input w-full bg-slate-800 border border-gray-500 rounded px-3 py-2 text-sm text-slate-50 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500"
              placeholder="Buscar miembro..."
              autocomplete="off"
            />
            <input type="hidden" name="miembro_id" id="miembro-id-hidden" />
            <button
              type="button"
              class="clear-btn absolute right-2 top-1/2 -translate-y-1/2 text-gray-400 hover:text-red-400 text-sm font-bold hidden"
              title="Limpiar"
            >
              ✕
            </button>
            <div
              class="dropdown-list absolute z-20 w-full mt-1 bg-slate-800 border border-gray-500 rounded shadow-lg max-h-48 overflow-y-auto hidden"
            >
            </div>
          </div>
        </div>
        <button
          type="submit"
          id="btn-agregar"
          class="bg-green-600 hover:bg-green-700 text-white text-sm font-medium px-5 py-2 rounded transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
          disabled
        >
          Agregar
        </button>
      </form>
    </div>

    <!-- Lista de integrantes actuales -->
    <div class="bg-slate-700 text-slate-50 p-6 rounded-lg shadow-md max-w-xl mx-auto">
      <h2 class="text-lg font-semibold mb-4">Integrantes Registrados</h2>
      <div id="lista-integrantes">
        {
          integrantesActuales.length === 0 ? (
            <p class="text-gray-400 text-sm text-center py-4">
              No hay integrantes registrados en este nivel.
            </p>
          ) : (
            <table class="min-w-full divide-y divide-gray-600">
              <thead class="bg-slate-800">
                <tr>
                  <th class="px-4 py-2 text-left text-sm font-semibold text-slate-50">
                    Nombre
                  </th>
                  <th class="px-4 py-2 text-left text-sm font-semibold text-slate-50">
                    Cédula
                  </th>
                  <th class="px-4 py-2 text-center text-sm font-semibold text-slate-50">
                    Acción
                  </th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-600" id="tbody-integrantes">
                {integrantesActuales.map((i) => (
                  <tr
                    data-integrante-id={i.id}
                    class="hover:bg-slate-600/50"
                  >
                    <td class="px-4 py-2 text-sm">
                      {i.miembro.nombre} {i.miembro.apellido}
                    </td>
                    <td class="px-4 py-2 text-sm text-gray-400">
                      {i.miembro.cedula}
                    </td>
                    <td class="px-4 py-2 text-center">
                      <button
                        type="button"
                        class="delete-btn bg-red-600 hover:bg-red-700 text-white text-xs font-medium px-3 py-1 rounded transition-colors"
                        data-id={i.id}
                        title="Eliminar integrante"
                      >
                        Eliminar
                      </button>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          )
        }
      </div>
    </div>
  </div>
</Layout>

<script define:vars={{ miembrosJSON, integrantesJSON }}>
  function initIntegrantes() {
    const miembros = JSON.parse(miembrosJSON);

    const searchInput = document.querySelector("#miembro-select .search-input");
    const hiddenInput = document.getElementById("miembro-id-hidden");
    const dropdown = document.querySelector(
      "#miembro-select .dropdown-list"
    );
    const clearBtn = document.querySelector("#miembro-select .clear-btn");
    const btnAgregar = document.getElementById("btn-agregar");

    function renderDropdown(search = "") {
      const searchLower = search.toLowerCase();
      let html = "";

      const filtrados = miembros.filter((m) => {
        const nombre = `${m.nombre} ${m.apellido}`.toLowerCase();
        return nombre.includes(searchLower);
      });

      if (filtrados.length === 0) {
        html = `<div class="px-3 py-2 text-sm text-gray-500">No se encontraron miembros</div>`;
      } else {
        for (const m of filtrados) {
          const nombre = `${m.nombre} ${m.apellido}`;
          html += `<div class="option-item px-3 py-2 text-sm cursor-pointer hover:bg-blue-600 text-slate-50" data-id="${m.id}" data-nombre="${nombre}">${nombre}</div>`;
        }
      }

      dropdown.innerHTML = html;
    }

    function updateClearBtn() {
      if (hiddenInput.value) {
        clearBtn.classList.remove("hidden");
        clearBtn.classList.add("block");
      } else {
        clearBtn.classList.add("hidden");
        clearBtn.classList.remove("block");
      }
    }

    searchInput.addEventListener("focus", () => {
      renderDropdown(searchInput.value);
      dropdown.classList.remove("hidden");
    });

    searchInput.addEventListener("input", () => {
      renderDropdown(searchInput.value);
      dropdown.classList.remove("hidden");
      if (!searchInput.value) {
        hiddenInput.value = "";
        btnAgregar.disabled = true;
        updateClearBtn();
      }
    });

    dropdown.addEventListener("click", (e) => {
      const option = e.target.closest(".option-item");
      if (!option) return;
      const id = option.dataset.id || "";
      const nombre = option.dataset.nombre || "";
      hiddenInput.value = id;
      searchInput.value = nombre;
      dropdown.classList.add("hidden");
      btnAgregar.disabled = false;
      updateClearBtn();
    });

    document.addEventListener("click", (e) => {
      if (!document.getElementById("miembro-select").contains(e.target)) {
        dropdown.classList.add("hidden");
      }
    });

    clearBtn.addEventListener("click", () => {
      hiddenInput.value = "";
      searchInput.value = "";
      btnAgregar.disabled = true;
      updateClearBtn();
      searchInput.focus();
    });

    updateClearBtn();

    // Eliminar integrante
    document.querySelectorAll(".delete-btn").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const integranteId = btn.dataset.id;
        if (!confirm("¿Estás seguro de eliminar este integrante del nivel?"))
          return;

        const formData = new FormData();
        formData.append("intent", "eliminar");
        formData.append("integrante_id", integranteId);

        btn.disabled = true;
        btn.textContent = "...";

        try {
          const response = await fetch(window.location.href, {
            method: "POST",
            body: formData,
          });

          if (response.ok) {
            const row = btn.closest("tr");
            row.remove();
            // Actualizar contador
            const tbody = document.getElementById("tbody-integrantes");
            if (tbody && tbody.children.length === 0) {
              document.getElementById("lista-integrantes").innerHTML =
                '<p class="text-gray-400 text-sm text-center py-4">No hay integrantes registrados en este nivel.</p>';
            }
            // Recargar para reflejar cambios
            window.location.reload();
          } else {
            throw new Error("Error en la respuesta");
          }
        } catch (error) {
          console.error("Error:", error);
          btn.textContent = "Error";
          setTimeout(() => {
            btn.textContent = "Eliminar";
            btn.disabled = false;
          }, 2000);
        }
      });
    });
  }

  document.addEventListener("astro:page-load", initIntegrantes);
</script>
