{
	"version": 3,
	"routes": [
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/_actions(?:/(.*?))?/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/asistencia/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/logout/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/miembros/check-cedula/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/miembros/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/crear/?$",
			"dest": "_render"
		},
		{
			"src": "^/dashboard/?$",
			"dest": "_render"
		},
		{
			"src": "^/discipulado/integrantes/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/discipulado/?$",
			"dest": "_render"
		},
		{
			"src": "^/editar/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/eventos/([^/]+?)/llegadas/?$",
			"dest": "_render"
		},
		{
			"src": "^/eventos/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/eventos/?$",
			"dest": "_render"
		},
		{
			"src": "^/listado/?$",
			"dest": "_render"
		},
		{
			"src": "^/login/?$",
			"dest": "_render"
		},
		{
			"src": "^/users/?$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		}
	]
}