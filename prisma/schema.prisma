generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model asistencia {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  miembro_id   String    @db.Uuid
  evento_id    String    @db.Uuid
  presente     Boolean   @default(false)
  hora_llegada DateTime? @db.Timestamptz(6)
  evento       evento    @relation(fields: [evento_id], references: [id], onDelete: Cascade)
  miembros     miembros  @relation(fields: [miembro_id], references: [id], onDelete: Cascade)

  @@unique([miembro_id, evento_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model equipos {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cod_equipo String   @unique
  des_equipo String
  miembros   miembros[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model evento {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre     String
  fecha      DateTime
  asistencia asistencia[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model miembros {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre      String
  apellido    String
  cedula      String   @unique
  direccion   String?
  telef       String?
  telf_2      String?
  status      Boolean  @default(true)
  zona_id     String   @db.Uuid
  kids        Boolean? @default(false)
  equipo_id   String   @db.Uuid
  discipulado String   @db.Char(1)
  bautizado   Boolean  @default(false)
  asistencia    asistencia[]
  equipo        equipos       @relation(fields: [equipo_id], references: [id])
  zonas         zonas         @relation(fields: [zona_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tutor_niveles           discipulado[]           @relation("TutorNivel")
  tim1_niveles            discipulado[]           @relation("Tim1Nivel")
  tim2_niveles            discipulado[]           @relation("Tim2Nivel")
  integrantes_discip      integrantes_discipulado[]
}

model integrantes_discipulado {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  miembro_id String  @db.Uuid
  nivel_cod  String

  miembro miembros    @relation(fields: [miembro_id], references: [id], onDelete: Cascade)
  nivel   discipulado @relation(fields: [nivel_cod], references: [nivel_cod], onDelete: Cascade)

  @@unique([miembro_id, nivel_cod])
}

model discipulado {
  nivel_cod    String    @id
  nombre_nivel String
  tutor_nivel  String?   @db.Uuid
  tim1_nivel   String?   @db.Uuid
  tim2_nivel   String?   @db.Uuid

  tutor_miembro miembros?                @relation("TutorNivel", fields: [tutor_nivel], references: [id])
  tim1_miembro  miembros?                @relation("Tim1Nivel", fields: [tim1_nivel], references: [id])
  tim2_miembro  miembros?                @relation("Tim2Nivel", fields: [tim2_nivel], references: [id])
  integrantes   integrantes_discipulado[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model zonas {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre_zona String
  miembros    miembros[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model usuarios {
  id             String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  nombre         String    @db.VarChar(50)
  correo         String    @unique(map: "usuarios_correo_idx") @db.VarChar(100)
  clave          String    @db.VarChar(255)
  rol            String    @default("usuario") @db.VarChar(20)
  activo         Boolean   @default(true)
  ultimo_login   DateTime? @db.Timestamp(6)
  creado_en      DateTime  @default(now()) @db.Timestamp(6)
  actualizado_en DateTime  @default(now()) @db.Timestamp(6)
}
